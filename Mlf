  {c:3,q:"انقسام السايتوبلازم في الخلية النباتية يتم بتكوين؟",o:["الصفيحة الوسطية", "التخصر", "الأسواط", "الأهداب"],a:0},
  {c:3,q:"عدد الكروموسومات بعد الانقسام الاختزالي لخلية بشرية جسمية (46)؟",o:["٢٣", "٤٦", "٩٢", "١٢"],a:0},
  {c:3,q:"تضاعف DNA قبل الانقسام يحدث في الطور؟",o:["البيني (مرحلة S)", "التمهيدي", "الانفصالي", "النهائي"],a:0}
];
let CH=0;
const GOOD=["جواب صحيح ✅"];
const BAD=["ما عليك، حاول بالجاي 💙","قريبة، ركّز أكثر 📘","هاي غلط، بس تتعلم منها ✨"];
const $=id=>document.getElementById(id);
const ar=n=>String(n).replace(/\d/g,d=>"٠١٢٣٤٥٦٧٨٩"[d]);
const mascot=$("mascot");
let order,i,score,locked;

function shuffle(a){a=a.slice();for(let k=a.length-1;k>0;k--){const j=Math.floor(Math.random()*(k+1));[a[k],a[j]]=[a[j],a[k]]}return a}
function pulse(cls){mascot.classList.remove("cheer","shake");void mascot.getBoundingClientRect();mascot.classList.add(cls)}
function talk(ms){mascot.classList.add("talk");setTimeout(()=>mascot.classList.remove("talk"),ms)}

let tm=[];
function setState(s){mascot.classList.remove("s-smile","s-laugh","s-wink","s-sad");if(s)mascot.classList.add("s-"+s)}
function say(t){const e=$("say");if(t){e.textContent=t;e.classList.add("on")}else e.classList.remove("on")}
function reset(){tm.forEach(clearTimeout);tm=[];setState(null);say(null);mascot.classList.remove("jump","cheer","shake")}
function later(f,ms){tm.push(setTimeout(f,ms))}
function celebrate(){reset();mascot.classList.add("jump");setState("smile");say("عاشت ايدك يا سبع السباع! 🦁");
  later(()=>{mascot.classList.remove("jump");setState("laugh")},650);
  later(()=>setState("wink"),2100);
  later(()=>{setState(null);say(null)},4200)}
function sad(){reset();mascot.classList.add("shake");setState("sad");say("ولا يهمك، حاول مرة ثانية 💙");later(reset,3000)}
function start(){const pool=BANK.filter(x=>CH===0||x.c===CH);order=shuffle(pool).slice(0,10);i=0;score=0;$("end").classList.add("hidden");$("game").classList.remove("hidden");show()}
function show(){
  reset();locked=false;const item=order[i];
  $("count").textContent="السؤال "+ar(i+1)+" من "+ar(order.length)+" · الفصل "+ar(item.c);
  $("score").textContent="النقاط: "+ar(score);
  $("q").textContent=item.q;$("fb").textContent="";$("next").classList.add("hidden");
  const box=$("opts");box.innerHTML="";
  const idx=shuffle(item.o.map((_,k)=>k));
  idx.forEach(k=>{const b=document.createElement("button");b.className="opt";b.textContent=item.o[k];b.onclick=()=>answer(b,k===item.a,idx,box);b.dataset.k=k;box.appendChild(b)});
  talk(Math.min(2600,item.q.length*55));
}
function answer(btn,right,idx,box){
  if(locked)return;locked=true;
  const item=order[i];
  [...box.children].forEach(b=>{b.disabled=true;if(+b.dataset.k===item.a)b.classList.add("ok")});
  if(right){score++;celebrate();$("fb").textContent=GOOD[Math.floor(Math.random()*GOOD.length)]}
  else{btn.classList.add("bad");sad();$("fb").textContent=BAD[Math.floor(Math.random()*BAD.length)]}
  $("score").textContent="النقاط: "+ar(score);
  $("next").textContent=i===order.length-1?"شوف النتيجة":"السؤال الجاي";
  $("next").classList.remove("hidden");$("next").focus({preventScroll:true});
}
function next(){
  if(i<order.length-1){i++;show();return}
  $("game").classList.add("hidden");$("end").classList.remove("hidden");
  const p=score/order.length;
  $("endmsg").textContent="جبت "+ar(score)+" من "+ar(order.length)+" — "+(p===1?"ممتاز! أنت فخر المرسى 🏆":p>=.6?"مستواك زين، كمل 💪":"ما عليك، نعيد ونتحسن 📚");
  p>=.6?celebrate():sad();
}
$("next").onclick=next;$("again").onclick=start;
function reask(){if(!locked&&!$("game").classList.contains("hidden")){talk(Math.min(2600,order[i].q.length*55));pulse("cheer")}}
mascot.addEventListener("click",reask);
mascot.addEventListener("keydown",e=>{if(e.key==="Enter"||e.key===" "){e.preventDefault();reask()}});
document.querySelectorAll(".chip").forEach(b=>b.onclick=()=>{CH=+b.dataset.c;document.querySelectorAll(".chip").forEach(x=>x.classList.toggle("on",x===b));start()});
start();

})();
</script>
</body>
</html>
