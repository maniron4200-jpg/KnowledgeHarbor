<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>مرسى السادس يسألك</title>
<style>
:root{--navy:#14274E;--gold:#C9A24B;--gold-soft:#E8D5A3;--bg:#F6F0E2;--card:#FFFFFF;--text:#14274E;--ok:#2E7D5B;--bad:#B3443A;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0C1730;--card:#14274E;--text:#F6F0E2;--gold-soft:#8A6F2F}}
:root[data-theme="dark"]{--bg:#0C1730;--card:#14274E;--text:#F6F0E2;--gold-soft:#8A6F2F}
*{box-sizing:border-box}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--text);font-family:'Cairo',-apple-system,system-ui,'Geeza Pro','Segoe UI',Tahoma,sans-serif;min-height:100vh;display:flex;justify-content:center}
main{width:100%;max-width:520px;padding:16px 16px 28px;display:flex;flex-direction:column;align-items:center}
h1{font-size:1.25rem;font-weight:900;margin:4px 0 0;text-align:center}
.sub{margin:2px 0 8px;font-size:.85rem;opacity:.75;text-align:center}
.bar{width:100%;display:flex;justify-content:space-between;font-weight:700;font-size:.9rem;border-bottom:2px solid var(--gold);padding-bottom:6px;margin-bottom:6px}
#mascot{position:relative;margin-top:40px;width:200px;height:200px;cursor:pointer;-webkit-tap-highlight-color:transparent;animation:bob 3s ease-in-out infinite;transform-origin:50% 90%}
#mascot img{width:100%;height:100%;display:block;border-radius:50%;box-shadow:0 5px 0 var(--gold)}
#mascot:focus-visible{outline:3px solid var(--gold);border-radius:50%}
@keyframes bob{50%{transform:translateY(-6px)}}
.blink{animation:blink 4s infinite;transform-origin:center;transform-box:fill-box}
@keyframes blink{0%,94%,100%{transform:scaleY(1)}97%{transform:scaleY(.1)}}
#mouth{transition:all .15s}
#mascot.talk{animation:talk .3s infinite alternate}
@keyframes talk{from{transform:scale(1,1)}to{transform:scale(1.03,.97) rotate(-1.5deg)}}
#tassel{transform-origin:150px 38px;animation:sway 2.4s ease-in-out infinite}
@keyframes sway{50%{transform:rotate(8deg)}}
#mascot.cheer{animation:cheer .6s}
@keyframes cheer{30%{transform:translateY(-22px) rotate(-4deg)}60%{transform:translateY(0) rotate(3deg)}}
#mascot.shake{animation:shake .45s}
@keyframes shake{25%{transform:translateX(-8px)}75%{transform:translateX(8px)}}
.bubble{position:relative;width:100%;background:var(--card);border:2.5px solid var(--navy);border-radius:20px;padding:16px 16px 14px;margin-top:10px;box-shadow:0 4px 0 var(--gold)}
:root[data-theme="dark"] .bubble,:root:not([data-theme="light"]) .bubble{border-color:var(--gold)}
.bubble::before{content:"";position:absolute;top:-12px;left:50%;margin-left:-10px;width:18px;height:18px;background:var(--card);border-top:2.5px solid var(--navy);border-right:2.5px solid var(--navy);transform:rotate(-45deg)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .bubble,:root:not([data-theme="light"]) .bubble::before{border-color:var(--gold)}}
#q{font-size:1.1rem;font-weight:700;line-height:1.7;margin:0 0 12px}
.opts{display:grid;gap:9px}
.opt{font:inherit;font-weight:700;font-size:1rem;text-align:right;padding:11px 14px;border-radius:14px;border:2px solid var(--gold);background:transparent;color:var(--text);cursor:pointer;transition:background .15s,transform .1s}
.opt:hover:not(:disabled){background:var(--gold-soft)}
.opt:active:not(:disabled){transform:scale(.98)}
.opt:focus-visible,.btn:focus-visible{outline:3px solid var(--gold);outline-offset:2px}
.opt.ok{background:var(--ok);border-color:var(--ok);color:#fff}
.opt.bad{background:var(--bad);border-color:var(--bad);color:#fff}
.opt:disabled{cursor:default}
#fb{min-height:1.6em;margin:12px 0 0;font-weight:700}
.btn{font:inherit;font-weight:900;font-size:1rem;margin-top:10px;padding:11px 26px;border:0;border-radius:14px;background:var(--navy);color:var(--gold-soft);cursor:pointer;box-shadow:0 3px 0 var(--gold)}
:root[data-theme="dark"] .btn,:root:not([data-theme="light"]) .btn{background:var(--gold);color:#14274E}
@media (prefers-color-scheme:light){.btn{background:var(--navy);color:#F6F0E2}}
.chips{display:flex;gap:6px;flex-wrap:wrap;justify-content:center;margin-bottom:8px}.chip{margin:2px;font:inherit;font-weight:700;font-size:.85rem;padding:5px 12px;border-radius:999px;border:2px solid var(--gold);background:transparent;color:var(--text);cursor:pointer}.chip.on{background:var(--gold);color:#14274E}.chip:focus-visible{outline:3px solid var(--gold);outline-offset:2px}
#mascot .fx{position:absolute;top:0;left:0;right:0;bottom:0;width:100%;height:100%;pointer-events:none}
#mascot .fx g{display:none}
#mascot.s-smile .cheeks,#mascot.s-laugh .cheeks,#mascot.s-wink .cheeks,#mascot.s-smile .smile,#mascot.s-wink .smile,#mascot.s-laugh .laugh,#mascot.s-laugh .tears,#mascot.s-laugh .eyeL,#mascot.s-laugh .eyeR,#mascot.s-wink .eyeR,#mascot.s-wink .spark,#mascot.s-sad .sad{display:inline}
.tears path{animation:fall .5s ease-in infinite;transform-box:fill-box}
@keyframes fall{from{transform:translateY(-6px);opacity:1}to{transform:translateY(30px);opacity:.2}}
.spark{animation:pop .4s ease-out;transform-box:fill-box;transform-origin:center}
@keyframes pop{from{transform:scale(0)}to{transform:scale(1)}}
#mascot.jump{animation:jump .65s ease-out}
@keyframes jump{35%{transform:translateY(-34px) scale(1.1) rotate(-3deg)}70%{transform:translateY(0) scale(.97)}}
#mascot.s-laugh{animation:giggle .16s infinite alternate}
@keyframes giggle{from{transform:translateY(0) rotate(-1.4deg)}to{transform:translateY(-5px) rotate(1.4deg)}}
.ha{display:none;position:absolute;top:6px;right:-26px;font-weight:900;font-size:1rem;background:var(--gold);color:#14274E;border-radius:12px;padding:1px 8px;animation:pop .3s}
#mascot.s-laugh .ha{display:block}
.say{position:absolute;top:-42px;left:50%;transform:translateX(-50%) scale(.85);opacity:0;white-space:nowrap;background:var(--gold);color:#14274E;font-weight:900;font-size:.95rem;padding:6px 14px;border-radius:16px;border:2.5px solid #14274E;transition:opacity .2s,transform .2s;pointer-events:none;z-index:2}
.say.on{opacity:1;transform:translateX(-50%) scale(1)}
.hidden{display:none}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body>
<main>
  <h1>مرسى السادس يسألك 🎓⚓</h1>
  <p class="sub">أحياء السادس العلمي، الفصول ١ إلى ٣. كل جولة ١٠ أسئلة جديدة</p>
  <div class="chips" id="chips"><button class="chip on" data-c="0">الكل</button><button class="chip" data-c="1">الفصل ١</button><button class="chip" data-c="2">الفصل ٢</button><button class="chip" data-c="3">الفصل ٣</button></div>
  <div class="bar"><span id="count">السؤال ١</span><span id="score">النقاط: ٠</span></div>

  <div id="mascot" role="button" tabindex="0" aria-label="مرسى السادس، اضغط لسؤال جديد"><img alt="شعار مرسى السادس" src="data:image/png;base64,"><svg class="fx" viewBox="0 0 1254 1254" aria-hidden="true">
  <g class="cheeks"><ellipse cx="440" cy="478" rx="40" ry="20" fill="#ff8f9c" opacity=".55"/><ellipse cx="705" cy="470" rx="40" ry="20" fill="#ff8f9c" opacity=".55"/></g>
  <g class="eyeL"><ellipse cx="440" cy="392" rx="110" ry="68" fill="#fff2f2"/><path d="M348 402 Q440 332 532 402" fill="none" stroke="#14274E" stroke-width="15" stroke-linecap="round"/></g>
  <g class="eyeR"><ellipse cx="660" cy="365" rx="124" ry="70" fill="#fff2f2"/><path d="M565 377 Q660 305 758 377" fill="none" stroke="#14274E" stroke-width="15" stroke-linecap="round"/></g>
  <g class="smile"><path d="M512 455 Q572 525 634 455" fill="none" stroke="#14274E" stroke-width="15" stroke-linecap="round"/></g>
  <g class="laugh"><path d="M508 450 Q572 595 636 450Z" fill="#4a1218" stroke="#14274E" stroke-width="9" stroke-linejoin="round"/><ellipse cx="572" cy="528" rx="32" ry="17" fill="#e8636f"/></g>
  <g class="tears"><path d="M372 470 q-16 28 0 40 q16 -12 0 -40z" fill="#6ec6ff"/><path d="M780 445 q-16 28 0 40 q16 -12 0 -40z" fill="#6ec6ff"/></g>
  <g class="spark"><path d="M800 300 l12 30 l30 12 l-30 12 l-12 30 l-12 -30 l-30 -12 l30 -12z" fill="#FFD43B" stroke="#14274E" stroke-width="6" stroke-linejoin="round"/></g>
  <g class="sad"><path d="M515 505 Q572 455 632 505" fill="none" stroke="#14274E" stroke-width="15" stroke-linecap="round"/><path d="M790 330 q-18 32 0 46 q18 -14 0 -46z" fill="#6ec6ff"/></g>
</svg><span class="ha" aria-hidden="true">😂 هههه</span><div class="say" id="say" aria-live="polite"></div></div>

  <section class="bubble" aria-live="polite">
    <noscript>لازم تفعّل JavaScript حتى تشتغل الصفحة</noscript>
    <div id="game">
      <p id="q">جاري تحميل الأسئلة…</p>
      <div class="opts" id="opts"></div>
      <p id="fb"></p>
      <div style="text-align:center"><button class="btn hidden" id="next">السؤال الجاي</button></div>
    </div>
    <div id="end" class="hidden" style="text-align:center">
      <p id="endmsg" style="font-size:1.1rem;font-weight:700;line-height:1.8;margin:0"></p>
      <button class="btn" id="again">جولة جديدة بأسئلة غيرها</button>
    </div>
  </section>
</main>

<script>
window.addEventListener("error",function(e){var q=document.getElementById("q");if(q)q.textContent="صار خطأ: "+e.message});
</script>
<script>
(function(){

// أسئلة أحياء سادس علمي. عدّل الأسئلة من هنا: q = السؤال، o = الخيارات، a = رقم الجواب الصحيح (يبدأ من 0)
